[Unit]
Description=Lock Zero before suspend
# The monitor calls into the running Zero shell. Wait until UWSM has imported
# ZERO_PATH and WAYLAND_DISPLAY, but keep the default target ordering so the
# monitor starts before graphical-session.target is reached.
After=dbus.socket wayland-session-waitenv.service
Requires=dbus.socket
PartOf=graphical-session.target
ConditionEnvironment=ZERO_PATH
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/zero-system-sleep-monitor
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
