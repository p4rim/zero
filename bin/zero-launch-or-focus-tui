#!/bin/bash

# zero:summary=Launch a TUI or focus an existing terminal window for it
# zero:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.zero.$(basename "$1")"
fi

LAUNCH_COMMAND="zero-launch-tui $@"

exec zero-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
