#!/bin/bash

# zero:summary=Log out after closing application windows
# zero:examples=zero logout | zero system logout
# zero:aliases=zero logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

zero-osd -i logout -m "Logging out" -d 5000

# Now close all windows
zero-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
