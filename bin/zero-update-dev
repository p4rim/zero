#!/bin/bash

# zero:summary=Update the active Zero dev checkout

set -euo pipefail

[[ $ZERO_PATH != "/usr/share/zero" ]] || exit 0

if ! git -C "$ZERO_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: ZERO_PATH is not a git checkout: $ZERO_PATH" >&2
  exit 1
fi

upstream=$(git -C "$ZERO_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip Zero dev checkout update (current branch has no upstream)\e[0m"
  exit 0
fi

echo -e "\e[32m\nUpdate Zero dev checkout\e[0m"
git -C "$ZERO_PATH" pull --ff-only
