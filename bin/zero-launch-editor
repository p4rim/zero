#!/bin/bash

# zero:summary=Launch the default editor selected via Zero defaults.
# zero:args=[--inline] <path>

default_editor="$HOME/.local/state/zero/defaults/editor"

if [[ ${1:-} == "--inline" ]]; then
  inline=true
  shift
else
  inline=false
fi

if [[ -f $default_editor ]]; then
  read -r editor <"$default_editor"
else
  editor="nvim"
fi

zero-cmd-present "$editor" || editor="nvim"

case "${editor##*/}" in
nvim | vim | nano | micro | hx | helix | fresh)
  if [[ $inline == "true" ]]; then
    exec "$editor" "$@"
  else
    exec zero-launch-tui "$editor" "$@"
  fi
  ;;
*)
  exec setsid uwsm-app -- "$editor" "$@"
  ;;
esac
