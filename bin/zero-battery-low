#!/bin/bash

# zero:summary=Send the low battery warning notification and run battery-low hooks.
# zero:args=<percentage>
# zero:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: zero-battery-low <percentage>" >&2
  exit 1
fi

level=$1

zero-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
zero-hook battery-low "$level"
