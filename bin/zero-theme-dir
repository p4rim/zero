#!/bin/bash

# zero:summary=Print the directory holding a theme, preferring a user-installed copy
# zero:args=<theme-name>
# zero:examples=zero theme dir tokyo-night

theme="${1:-}"

if [[ -z $theme ]]; then
  echo "Usage: zero-theme-dir <theme-name>" >&2
  exit 1
fi

if [[ -d $HOME/.config/zero/themes/$theme ]]; then
  echo "$HOME/.config/zero/themes/$theme"
else
  echo "$ZERO_PATH/themes/$theme"
fi
