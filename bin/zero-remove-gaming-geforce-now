#!/bin/bash

# zero:summary=Remove the GeForce NOW Flatpak app and its data.
# zero:group=remove
# zero:name=gaming geforce-now

set -e

if zero-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
