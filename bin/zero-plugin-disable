#!/bin/bash

# zero:summary=Disable a shell plugin
# zero:group=plugin
# zero:args=<id>

set -euo pipefail

fail() {
  echo "zero-plugin-disable: $*" >&2
  exit 1
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: zero plugin disable <id>"
  exit 0
fi

id="${1:-}"
[[ -n $id ]] || fail "plugin id is required"

result=$(zero-shell shell setPluginEnabled "$id" false)
[[ $result == "ok" ]] ||
  fail "plugin '$id' is not known; run: zero-shell shell rescanPlugins"

echo "Disabled $id"
