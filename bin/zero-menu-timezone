#!/bin/bash

# zero:summary=Select and set the system timezone
# zero:group=menu
# zero:name=timezone

set -e

timezone=$(timedatectl list-timezones | zero-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
zero-shell -q zero.clock refresh
zero-notification-send "Timezone is now set to $timezone"
